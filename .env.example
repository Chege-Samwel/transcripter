# Authentication
# In production use a long random SESSION_SECRET and a bcrypt hash.
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_EMAIL=editor@your-company.com
AUTH_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash
# Note: in LOCAL .env files only, escape every $ in the hash (e.g.
# AUTH_PASSWORD_HASH=\$2b\$12\$...) — Next.js interpolates $-references when
# loading .env files and would mangle the hash. Deploy platforms (Vercel,
# Render, ...) inject env vars verbatim, so use the plain hash there.
#
# AUTH_EMAIL is the bootstrap admin. On first successful sign-in it is
# upserted as role=admin, status=approved. Everyone else registers as
# awaiting_approval and can only run a demo until an admin approves them.

# Provider (optional — without it, batches use the local preview transform)
NVIDIA_API_KEY=replace-with-your-nvidia-api-key

# Optional: override the chat-completions endpoint (self-hosted NIM gateway,
# or a stub for testing). Defaults to the NVIDIA hosted API.
# NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Server persistence (Postgres — Neon, Supabase, Render, RDS, ...)
# Use the standard Postgres connection string. For Neon, either the direct
# connection string or the pooled (-pooler) one both work.
#
# Required for registrations, approval enums, and history across devices.
# The app applies db/migrations automatically on first use.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: set to 1 to disable automatic schema migrations at runtime
# (migrations are then applied only via "npm run db:migrate").
# DISABLE_AUTO_MIGRATE=1

# Demo word cap for awaiting_approval accounts (default 600)
# DEMO_WORD_CAP=600
